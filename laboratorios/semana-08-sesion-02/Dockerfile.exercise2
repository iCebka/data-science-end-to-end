FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY starter/viajes_taxi.csv ./starter/viajes_taxi.csv
COPY plantilla-ejercicio2/explorar_relaciones.py ./plantilla-ejercicio2/explorar_relaciones.py

# La plantilla lee ../starter/viajes_taxi.csv desde su propia carpeta.
WORKDIR /app/plantilla-ejercicio2
CMD ["python3", "explorar_relaciones.py"]
